# Waymark 2100 Mobile Environment Configuration Example
# Copy this file to .env.development or .env.production
# DO NOT COMMIT REAL SECRETS OR LOCAL .env FILES

# Transit API Base URL
EXPO_PUBLIC_API_URL=https://api.waymark2100.local/v1

# Request Timeout in Milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Application Environment (development, staging, production)
EXPO_PUBLIC_APP_ENV=development

# Feature Flags
EXPO_PUBLIC_ENABLE_AIR_SHUTTLES=true
EXPO_PUBLIC_ENABLE_OFFLINE_CACHE=true
